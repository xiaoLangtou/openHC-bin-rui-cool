<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
            仅调试构建：投屏画面与触控的演示。不连手机，播放运行时现生成的合成码流，
            用来在车机上检查解码、显示比例、全屏和触摸换算。不放桌面图标（车机桌面上多一个图标碍事），需要时用 adb 打开：
            adb shell am start -n io.github.gcbond.openhc/.demo.ProjectionDemoActivity
        -->
        <activity
            android:name=".demo.ProjectionDemoActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:exported="true"
            android:label="@string/demo_label">
        </activity>

        <!-- 仅调试构建：让无线调度马上走一次车机主动回连（adb am start 启动；见 ReconnectNowActivity）。 -->
        <activity
            android:name=".demo.ReconnectNowActivity"
            android:exported="true"
            android:label="主动回连（调试）" />

    </application>
</manifest>
