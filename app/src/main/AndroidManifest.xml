<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:sharedUserId="android.uid.system">

    <!-- 和手机之间的 TCP/UDP（经 USB 网卡）。 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 手填蓝牙地址备份进系统全局设置表（signature 权限，系统签名自动授予；普通签名版写不进，备份静默跳过）。 -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" tools:ignore="ProtectedPermissions" />
    <!-- 读车机本机蓝牙真地址（DeviceInfo.localBluetoothAddress；普通应用拿到的多半是掩码地址，系统签名才给真值）。 -->
    <uses-permission android:name="android.permission.LOCAL_MAC_ADDRESS" tools:ignore="ProtectedPermissions" />
    <!-- 读取车机蓝牙 AVRCP MediaSession 元数据兜底（手机部分鸿蒙/三方播放器不发 515 时，从 com.android.bluetooth 会话补齐歌名歌手）。 -->
    <uses-permission android:name="android.permission.MEDIA_CONTENT_CONTROL" tools:ignore="ProtectedPermissions" />
    <!-- 车机无 CarMedia 时，直连 ECARX MediaCenterAPI 主动向仪表屏与桌面推送 Link EAS 媒体卡片。 -->
    <uses-permission android:name="ecarx.oem.permission.OPENAPI_MEDIACENTER_PERMISSION" />
    <!-- 连接期间留在前台，切到后台不断（安卓 9 起要声明）。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- 安卓 14 起前台服务要按类型声明权限。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!--
        安卓 14 起 connectedDevice 类型的前台服务还要满足运行时前置条件之一（声明几种网络类普通权限之一、
        拿到蓝牙运行时权限，或已有 USB 设备授权）。开始等插线时手机还没插上、没有 USB 授权可用，
        所以声明这个普通权限（安装即授予）来满足；本应用不用它改任何网络设置。
    -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!-- 安卓 13 起显示前台服务通知要用户授权；拒绝了连接照常进行，只是看不到通知。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
        车机麦克风交给手机（打电话、语音助手）：运行时权限，开始连接前申请。拒绝了连接照常进行，只是不声明麦克风，
        手机继续用自己的麦克风。
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
        无线连接（扫码 → 蓝牙 → WiFi：车机开热点）：
        - 蓝牙：安卓 11 及以前是安装即授予的旧权限；安卓 12 起开 RFCOMM 监听要运行时权限「附近的设备」。
        - WiFi：读写 WiFi 状态是普通权限；开本地热点在安卓 13 起要「附近的 WiFi 设备」（声明不用于定位），
          更早的版本要精确位置（安卓 12/12L 上要和大致位置一起申请，系统框里才能选精确；安卓 8～12 开热点还要系统定位开关打开）。
          安卓 9 及以下「退出后恢复车机 WiFi」用 CHANGE_WIFI_STATE 打开 WiFi。本应用不读取位置。
    -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!--
        无线自动回连：车机发 BLE 广播、挂 GATT 服务，让配对过的手机靠近时自己连上来。安卓 12 起发广播要运行时权限
        （也在「附近的设备」里），开始无线连接时一起申请；拒绝了照样能扫码，只是不能自动回连。更早用上面的旧权限。
        设置「补全手机蓝牙配对」也用这几个：临时改车机蓝牙名称、挂 GATT 服务、发带名称的广播，结束时改回名称。
    -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.ACCESS_COARSE_LOCATION"
        android:maxSdkVersion="32" />
    <!-- 这个属性安卓 12 起才有、这个权限安卓 13 起才有，老版本上两者都不起作用。 -->
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:ignore="UnusedAttribute" />

    <!-- 没有蓝牙的车机仍可安装，只是用不了无线连接。 -->
    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="false" />

    <!--
        设置「开机自动打开 OpenHC」（默认关）：收开机广播（熄火后再点火时有的车机会重发），收到后打开界面。
        安卓 10 起后台应用打开界面要悬浮窗权限，由车主在系统里给；没给时开机打不开界面，其余功能不受影响。
        再开着「开机静默连接」时开机不打开界面，在后台起前台服务等手机，手机连上时才把界面带到前台（同样要悬浮窗权限）。
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- 有线连接要车机支持 USB 主机模式；不支持的车机仍可安装，只是用不了有线。 -->
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />

    <!--
        车机 GOC 定制蓝牙栈在 GattService 广播入口调 enforceAdminPermission()（查 BLUETOOTH_PRIVILEGED），
        没有该权限的三方应用请求被静默丢弃（无日志、无回调）。本应用用 platform 密钥签名并共享
        android.uid.system（与官方 CarLink 同款打包方式），此 signature 级权限即可自动授予，广播放行。
    -->
    <uses-permission android:name="android.permission.BLUETOOTH_PRIVILEGED" tools:ignore="ProtectedPermissions" />
    <!--
        有线连接静默自授（系统签名 + android.uid.system 时不再依赖电脑敲 adb 命令）：
        - CONTROL_VPN：直调 ConnectivityService 的 setVpnPackageAuthorization / prepareVpn，免 VPN 授权框（车机常没有 com.android.vpndialogs）。
        - MANAGE_APP_OPS_MODES / UPDATE_APP_OPS_STATS：把本应用的 ACTIVATE_VPN appop 置 allow（等价 adb shell appops set <pkg> ACTIVATE_VPN allow）。
        - MANAGE_USB：经 UsbManager/IUsbManager 直接授予 USB 设备权限，免 USB 授权框。
        四个都是 signature|privileged 级别，平台密钥签名自动授予；普通签名版拿不到权限时反射调用失败，
        安全回退到既有的弹窗流程，行为不变。
    -->
    <uses-permission android:name="android.permission.CONTROL_VPN" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.MANAGE_APP_OPS_MODES" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.UPDATE_APP_OPS_STATS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.MANAGE_USB" tools:ignore="ProtectedPermissions" />
    <!-- 比亚迪车机「选择禁止后台启动项」对话框：安卓 11 起要声明，才查得到车机上有没有它（设置 → 启动）。 -->
    <!-- <queries> 仅 API 30+ 有意义（BYD 应用启动管理），Android 9 的 PackageParser 不认识该元素、
         会导致整包 INSTALL_FAILED_INVALID_APK，车机（API 28）上所有包本来可见，直接去掉。 -->

    <application
        android:name=".OpenHcApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:usesCleartextTraffic="true">
        <!--
            usesCleartextTraffic：诊断上报的服务器地址是车主自己填的（默认 http://121.36.29.74:3800），
            局域网/公网 http 都算明文，targetSdk 28 起默认拦。这里放开（投屏本身的 TCP 不受这个策略管）。
        -->

        <!--
            车机屏幕可能会旋转、切换昼夜，界面自己处理，不重建 Activity。
            singleTop：插线拉起时（会话中途手机重新枚举也会再拉一次）交给已有的界面（onNewIntent），不叠新界面。
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            插线就连（设置「插线时不再弹窗」，默认关，开关启停这个别名）：启用时插上华为、荣耀手机，系统问用不用本应用打开，
            授权框也带「默认使用」勾选框；勾过以后系统直接授权并拉起 MainActivity。停用时系统不认本应用能处理手机，
            插线不拉起，框里也没有「默认使用」。
        -->
        <activity-alias
            android:name=".UsbAttachAlias"
            android:enabled="false"
            android:exported="true"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/usb_device_filter" />
        </activity-alias>

        <!-- 开机自动打开（设置里的开关启停它，默认停用）：开机广播只有系统能发。 -->
        <receiver
            android:name=".startup.BootStartReceiver"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- 有线投屏的前台服务：只由本应用自己启动。 -->
        <service
            android:name=".connection.ConnectionService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- 无线投屏的前台服务：只由本应用自己启动。 -->
        <service
            android:name=".wireless.WirelessService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!--
            蓝牙连上自动连接：手机的经典蓝牙连上 / 断开车机时（ACL_CONNECTED / ACL_DISCONNECTED），以及 HFP/A2DP 等
            Profile 连接状态变化（Profile 连上说明建链已稳定，立即拨；Profile 断开不当作手机断开），由系统广播叫醒本应用。
            默认不启用，设置里打开「蓝牙连上自动连接」（且没开「只用数据线连接」）时才启用，免得连别的蓝牙设备也把本应用拉起来。
            这些广播只有系统能发，所以导出也无妨（不导出的话系统蓝牙进程发的广播收不到）。
        -->
        <receiver
            android:name=".wireless.BluetoothConnectionReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
                <action android:name="android.bluetooth.a2dp.profile.action.CONNECTION_STATE_CHANGED" />
                <action android:name="android.bluetooth.a2dp-sink.profile.action.CONNECTION_STATE_CHANGED" />
                <action android:name="android.bluetooth.headset.profile.action.CONNECTION_STATE_CHANGED" />
                <action android:name="android.bluetooth.headsetclient.profile.action.CONNECTION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- 暴露给车机 ECARX 媒体中心（系统进程）读取 HiCar 专辑封面的 ContentProvider。 -->
        <provider
            android:name=".media.ClusterArtProvider"
            android:authorities="${applicationId}.eas"
            android:exported="true"
            android:grantUriPermissions="true" />

        <!-- ECARX OpenAPI 鉴权元数据（与吉利 CarLink / LinkHMI 同款，供无蓝牙音乐时直推 Link EAS 卡片）。 -->
        <meta-data
            android:name="eCarX_OpenAPI_AppId"
            android:value="42b8433d3528471a98504554cc4ea5ad" />
        <meta-data
            android:name="eCarX_OpenAPI_AppKey"
            android:value="a0a3234cc6584253b0ea2a102d173ce8" />
    </application>
</manifest>
